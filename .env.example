# Copy to .env and fill in your keys.

# fast_llm_sql and structured planner settings
AGENT_PROVIDER=openai
AGENT2UI_LLM_PLANNER=auto
AGENT2UI_PLANNER_MODEL=gpt-4.1-mini
OPENAI_API_KEY=replace-me
AGENT_MODEL=gpt-4.1-mini
AGENT_REASONING_EFFORT=none
# Prepare a separate read-only query database (not included in public source).
ORDER_UI_DB_PATH=Data/database.sqlite
ORDER_UI_STATE_DB_PATH=Data/runtime_state.sqlite
SCHEMA_RETRIEVAL_TOP_K=3
SCHEMA_SEMANTIC_MAX_CHARS=12000
# SCHEMA_SUMMARY_PATH=Data/docs/schema_summary.md
# SCHEMA_VALUE_ALIASES_PATH=Data/docs/value_aliases.json
# FAST_SQL_TOTAL_TIMEOUT_SECONDS=45
# AGENT_RUN_TIMEOUT_SECONDS=50  # SQL 총 제한보다 길게 설정

# Local LM Studio
# LM_STUDIO_BASE_URL=http://127.0.0.1:1234/v1
# AGENT_MODEL=your-loaded-model-id
