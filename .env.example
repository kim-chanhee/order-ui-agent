# Copy to .env and fill in your keys.
# Select all database-specific files together (paths inside the profile are relative to it).
# DATA_PROFILE_PATH=Data/profiles/my-data/profile.json
# Development runs: keep state/logs separate from participant research data.
# ORDER_UI_STATE_DB_PATH=artifacts/validation/runtime_state.sqlite
# ORDER_UI_LOG_DIR=artifacts/validation/logs

# fast_llm_sql and structured planner settings
AGENT_PROVIDER=openai
AGENT2UI_LLM_PLANNER=auto
AGENT2UI_PLANNER_MODEL=gpt-4.1-mini-2025-04-14
OPENAI_API_KEY=replace-me
AGENT_MODEL=gpt-4.1-mini-2025-04-14
AGENT_REASONING_EFFORT=none
# Prepare a separate read-only query database (not included in public source).
ORDER_UI_DB_PATH=Data/database.sqlite
ORDER_UI_STATE_DB_PATH=Data/runtime_state.sqlite
SCHEMA_RETRIEVAL_TOP_K=3
SCHEMA_SEMANTIC_MAX_CHARS=12000
# SCHEMA_SUMMARY_PATH=Data/docs/schema_summary.md
# SCHEMA_VALUE_ALIASES_PATH=Data/docs/value_aliases.json
# ANALYSIS_SEMANTICS_PATH=Data/docs/analysis_semantics.json
# FAST_SQL_TOTAL_TIMEOUT_SECONDS=45
# AGENT_RUN_TIMEOUT_SECONDS=50  # SQL 총 제한보다 길게 설정

# Local LM Studio
# LM_STUDIO_BASE_URL=http://127.0.0.1:1234/v1
# AGENT_MODEL=your-loaded-model-id

# Bounded API use: applies to routing, planning, SQL and explanations alike.
AGENT_TIMEOUT_SECONDS=45
FAST_SQL_TIMEOUT_SECONDS=30
FAST_SQL_TOTAL_TIMEOUT_SECONDS=90
AGENT_RUN_TIMEOUT_SECONDS=240
LLM_MAX_CALLS_PER_REQUEST=12
LLM_MAX_PROMPT_BYTES=120000
LLM_ROUTING_MAX_OUTPUT_TOKENS=700
LLM_PLANNER_MAX_OUTPUT_TOKENS=4000
LLM_REPLY_MAX_OUTPUT_TOKENS=700
FAST_SQL_MAX_TOKENS=1600
# These limit requests/payloads/outputs, not a guaranteed currency budget.
# Provider-reported usage: <ORDER_UI_LOG_DIR>/llm_usage.jsonl
